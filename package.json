{
  "name": "webxlights",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "test": "npm run test -w packages/engine",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w packages/engine",
    "lint": "eslint packages && npm run lint -w apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.66.0"
  }
}
